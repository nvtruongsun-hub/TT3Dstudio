    {
      "dot": "emerald",
      "title": "Go Gateway & Business Services",
      "items": [
        "Go API Gateway manages reverse proxying, JWT authentication, and rate limiting",
        "Order Service executes core business logic and inventory allocation via gRPC",
        "Redis stores user sessions and caches hot product catalog entries in-memory"
      ]
    },
    {
      "dot": "rose",
      "title": "Persistence & Event Streaming",
      "items": [
        "PostgreSQL maintains ACID consistency for orders, billing, and inventory",
        "Kafka broker streams order.created and payment.completed topics asynchronously",
        "Fulfillment workers decouple email, SMS, and shipping workflows from user checkout"
